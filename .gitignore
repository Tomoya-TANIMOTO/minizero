# execute and library file
build/
__pycache__

# configuration file
*.cfg
# 評価用 cfg は n スイープの再現に必要なので追跡する
# (gitignore は後勝ちなので *.cfg より後ろに置くこと)
!xrl_viz/cfg/*.cfg

# training folder
*_az_*/
*_gaz_*/
*_mz_*/
*_gmz_*/

# others
.vscode
.container_root

*.json_bak*
*.jsonl

# research data (keep game.json for GUI, ignore the rest)
xrl_viz/data/*.json
xrl_viz/data/**/*.json
# 実行時の進捗ログ (2 行だけで再現情報を持たない)
xrl_viz/data/*.log
xrl_viz/data/**/*.log
# 破損ハーネスの再現物一式 (json 以外の .out/.err も含むため明示)
xrl_viz/data/_corrupt_harness_bug/
xrl_viz/game_eval_fixed.json
xrl_viz/tree.json
xrl_viz/tree_first.json
